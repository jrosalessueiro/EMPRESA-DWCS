{# templates/registration/register.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ 'titulo.registro'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'titulo.registro'|trans }}</h1>

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm) }}
        {{ form_row(registrationForm.email, { 'label': 'campo.email'|trans }) }}
        {{ form_row(registrationForm.nombre, { 'label': 'campo.nombre'|trans }) }}
        {{ form_row(registrationForm.apellidos, { 'label': 'campo.apellidos'|trans }) }}
        {{ form_row(registrationForm.plainPassword, { 'label': 'campo.password'|trans }) }}

        <button type="submit" class="btn">{{ 'boton.registrar'|trans }}</button>
    {{ form_end(registrationForm) }}
{% endblock %}